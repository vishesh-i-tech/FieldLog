# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Neon PostgreSQL Connection Strings
# 1. DATABASE_URL: Pooled connection string (PgBouncer) used for running backend API
# Example: postgresql://neondb_owner:npg_xyz@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. DIRECT_URL: Direct unpooled connection string used for running Drizzle migrations
# Example: postgresql://neondb_owner:npg_xyz@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=

# Authentication Secret (Minimum 32 characters)
JWT_SECRET=dailyrecord-super-secret-key-change-in-production-min32chars!

# Storage configuration (dev = local stub in uploads/)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
