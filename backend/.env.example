# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Turso / libSQL Database Connection
# 1. Local SQLite file (runs automatically with zero cloud setup):
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# 2. Turso Cloud (for production):
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Authentication Secret (Minimum 32 characters)
JWT_SECRET=dailyrecord-super-secret-key-change-in-production-min32chars!

# Storage configuration (dev = local stub in uploads/)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
